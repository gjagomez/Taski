# Copia este archivo como .env y completa los valores.
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=admin
DB_NAME=gestor_proyectos
# Cadena larga y aleatoria para firmar las sesiones (JWT)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Asistente IA local (LM Studio, API compatible con OpenAI)
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gemma-3-4b-it-qat
AI_PORT=4001

# Correo (Mailjet). Sin API key/secret el backend no envía nada: guarda el HTML en Backend/outbox/
# y en desarrollo muestra el código de recuperación en pantalla.
# El remitente debe estar validado en Mailjet (Account settings > Sender domains & addresses).
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TaskiTask
# Enlace de los botones del correo
APP_URL=http://localhost:5173
